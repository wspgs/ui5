function Section:AddSlider(o)
	local hub, T = self.Hub, self.Hub.Theme
	local row = self:_row(o.Name, o.Desc, 108, o.Badge, true)
	local min, max = o.Min or 0, o.Max or 100
	local inc = o.Increment or 1
	local decimals = decimalsOf(inc)
	local suffix = o.Suffix or ""
	local obj = { Value = math.clamp(o.Default or min, min, max) }

	local valLabel = label(row, "", 12, T.AccentHi, Enum.Font.GothamBold, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 10),
		Size = UDim2.fromOffset(120, 16),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local inset = make("Frame", {
		Position = UDim2.fromOffset(14, 54),
		Size = UDim2.new(1, -28, 0, 42),
		BackgroundColor3 = T.Inset,
		BorderSizePixel = 0,
	}, row)
	round(inset, 9)
	local track = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.new(1, -32, 0, 6),
		BackgroundColor3 = T.Off,
		BorderSizePixel = 0,
	}, inset)
	round(track, 3)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track)
	round(fill, 3)
	make("UIGradient", { Color = ColorSequence.new(T.AccentDark, T.Accent) }, fill)
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(17, 17),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, fill)
	round(knob, 9)
	local grab = make("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, inset)

	local lastTick = obj.Value
	local function render(v)
		local a = (v - min) / math.max(max - min, 1e-9)
		fill.Size = UDim2.fromScale(a, 1)
		valLabel.Text = string.format("%." .. decimals .. "f", v) .. suffix
	end
	function obj:Set(v, silent)
		v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
		v = tonumber(string.format("%.4f", v))
		self.Value = v
		render(v)
		if not silent and o.Callback then
			task.spawn(o.Callback, v)
		end
	end
	function obj:Get()
		return self.Value
	end

	bindDrag(hub, grab, function(a)
		obj:Set(min + (max - min) * a)
		if obj.Value ~= lastTick then
			lastTick = obj.Value
			hub:_play("Hover")
		end
	end, track)
	render(obj.Value)
	return obj
end

