local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
	local lookup = {}
	for i = 1, #B64CHARS do
		lookup[B64CHARS:byte(i)] = i - 1
	end
	local out, n, buffer, bits = {}, 0, 0, 0
	for i = 1, #data do
		local v = lookup[data:byte(i)]
		if v then
			buffer = buffer * 64 + v
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				local div = 2 ^ bits
				local byte = math.floor(buffer / div)
				buffer = buffer % div
				n = n + 1
				out[n] = string.char(byte)
			end
		end
	end
	return table.concat(out)
end

local assetCache = {}
local function embeddedAsset(key)
	if assetCache[key] ~= nil then
		return assetCache[key] or nil
	end
	local res
	if B64[key] then
		local ok, r = pcall(function()
			local fname = "tanghub_" .. key .. ".png"
			writefile(fname, b64decode(B64[key]))
			return getcustomasset(fname)
		end)
		if ok and r then
			res = r
		end
	end
	assetCache[key] = res or false
	return res
end

