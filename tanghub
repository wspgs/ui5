function Section:AddToggle(o)
	local hub, T = self.Hub, self.Hub.Theme
	local row, hit = self:_row(o.Name, o.Desc, 58, o.Badge, false)
	local obj = { Value = o.Default == true }

	local sw = make("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(47, 25),
		BackgroundColor3 = obj.Value and T.Accent or T.Off,
		BorderSizePixel = 0,
	}, row)
	round(sw, 13)
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = obj.Value and UDim2.new(1, -22.5, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(19, 19),
		BackgroundColor3 = obj.Value and Color3.new(1, 1, 1) or T.PetalIcon,
		BorderSizePixel = 0,
	}, sw)
	round(knob, 10)

	function obj:Set(v, silent)
		self.Value = v and true or false
		tw(sw, 0.15, { BackgroundColor3 = self.Value and T.Accent or T.Off })
		tw(knob, 0.15, {
			Position = self.Value and UDim2.new(1, -22.5, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = self.Value and Color3.new(1, 1, 1) or T.PetalIcon,
		})
		if not silent and o.Callback then
			task.spawn(o.Callback, self.Value)
		end
	end
	function obj:Get()
		return self.Value
	end

	hub:_connect(hit.MouseButton1Click, function()
		obj:Set(not obj.Value)
		hub:_play(obj.Value and "On" or "Off")
	end)
	return obj
