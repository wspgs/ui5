	})
	label(btn, "▾", 13, T.Muted, Enum.Font.GothamBold, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	function obj:Set(v, silent)
		self.Value = v
		txt.Text = tostring(v)
		if not silent and o.Callback then
			task.spawn(o.Callback, v)
		end
	end
	function obj:Get()
		return self.Value
	end

	hub:_connect(btn.MouseButton1Click, function()
		hub:_play("Click")
		local e = hub:_eff()
		local blocker = make("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 50,
		}, hub.Gui)
		local visibleCount = math.min(#options, 6)
		local list = make("ScrollingFrame", {
			Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 5 * e),
			Size = UDim2.fromOffset(btn.AbsoluteSize.X / e, visibleCount * 30 + 10),
			BackgroundColor3 = T.Bg,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = T.Accent,
			ZIndex = 51,
		}, hub.Gui)
		make("UIScale", { Scale = e }, list)
		round(list, 9)
		stroke(list, T.Border, 1, 0.4)
		make("UIListLayout", { Padding = UDim.new(0, 2) }, list)
		pad(list, 5, 5, 5, 5)
		local function close()
			blocker:Destroy()
			list:Destroy()
		end
		for _, opt in ipairs(options) do
			local bb = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = T.Accent,
				BackgroundTransparency = (opt == obj.Value) and 0.55 or 1,
				BorderSizePixel = 0,
				Text = tostring(opt),
				TextSize = 12,
				TextColor3 = T.Text,
				Font = Enum.Font.GothamMedium,
				AutoButtonColor = false,
			}, list)
			round(bb, 6)
			bb.MouseEnter:Connect(function()
				hub:_play("Hover")
				tw(bb, 0.1, { BackgroundTransparency = 0.4 })
			end)
			bb.MouseLeave:Connect(function()
				tw(bb, 0.1, { BackgroundTransparency = (opt == obj.Value) and 0.55 or 1 })
			end)
			bb.MouseButton1Click:Connect(function()
				obj:Set(opt)
				hub:_play("Click")
				close()
			end)
		end
		blocker.MouseButton1Click:Connect(close)
	end)
	return obj
end

function Section:AddKeybind(o)
	local hub, T = self.Hub, self.Hub.Theme
	local row = self:_row(o.Name, o.Desc, 58, o.Badge, false)
	local obj = { Value = o.Default, Listening = false }

	local btn = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(84, 31),
		BackgroundColor3 = T.RowAlt,
		BorderSizePixel = 0,
		Text = keyName(obj.Value),
		TextSize = 12,
		TextColor3 = T.Text,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
	}, row)
	round(btn, 8)
	stroke(btn, T.Border, 1, 0.7)

	function obj:Set(key)
		self.Value = key
		btn.Text = keyName(key)
	end
	function obj:Get()
		return self.Value
	end

	hub:_connect(btn.MouseButton1Click, function()
		obj.Listening = true
		btn.Text = "..."
		hub:_play("Click")
	end)
	hub:_connect(UserInputService.InputBegan, function(i, gp)
		if obj.Listening then
			if i.UserInputType == Enum.UserInputType.Keyboard then
				obj.Listening = false
				if i.KeyCode == Enum.KeyCode.Escape or i.KeyCode == Enum.KeyCode.Backspace then
					obj:Set(nil)
				else
					obj:Set(i.KeyCode)
				end
				hub:_play("Click")
			end
			return
		end
		if not gp and obj.Value and i.KeyCode == obj.Value and o.Callback then
			task.spawn(o.Callback)
		end
	end)
	return obj
end

