-- swatch in the row; clicking the row opens hue + brightness bars
function Section:AddColorPicker(o)
	local hub, T = self.Hub, self.Hub.Theme
	local row, hit = self:_row(o.Name, o.Desc, 58, o.Badge, true)
	local default = o.Default or T.Accent
	local h, s, v = default:ToHSV()
	local obj = { Value = default }
	local open = false

	local swatch = make("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 19),
		Size = UDim2.fromOffset(46, 21),
		BackgroundColor3 = default,
		BorderSizePixel = 0,
	}, row)
	round(swatch, 5)
	stroke(swatch, Color3.new(1, 1, 1), 1, 0.75)

	local inset = make("Frame", {
		Position = UDim2.fromOffset(14, 58),
		Size = UDim2.new(1, -28, 0, 78),
		BackgroundColor3 = T.Inset,
		BorderSizePixel = 0,
		Visible = false,
	}, row)
	round(inset, 9)

	local function bar(y)
		local b = make("Frame", {
			Position = UDim2.new(0, 16, 0, y),
			Size = UDim2.new(1, -32, 0, 10),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, inset)
		round(b, 5)
		local k = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(8, 18),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, b)
		round(k, 4)
		stroke(k, Color3.new(0, 0, 0), 1, 0.5)
		local g = make("TextButton", {
			Position = UDim2.fromOffset(0, -8),
			Size = UDim2.new(1, 0, 1, 16),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, b)
		return b, k, g
	end
	local hueBar, hueKnob, hueGrab = bar(16)
	local valBar, valKnob, valGrab = bar(50)
	local hueKeys = {}
	for i = 0, 6 do
		table.insert(hueKeys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1)))
	end
	make("UIGradient", { Color = ColorSequence.new(hueKeys) }, hueBar)
	local valGradient = make("UIGradient", {}, valBar)

	local function refresh(silent)
		local c = Color3.fromHSV(h, s, v)
		obj.Value = c
		swatch.BackgroundColor3 = c
		hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
		valKnob.Position = UDim2.new(v, 0, 0.5, 0)
		valGradient.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, math.max(s, 0.6), 1))
		if not silent and o.Callback then
			task.spawn(o.Callback, c)
		end
	end
	function obj:Set(c, silent)
		h, s, v = c:ToHSV()
		refresh(silent)
	end
	function obj:Get()
		return self.Value
	end

	hub:_connect(hit.MouseButton1Click, function()
		open = not open
		hub:_play("Click")
		if open then
			inset.Visible = true
			tw(row, 0.2, { Size = UDim2.new(1, 0, 0, 148) })
		else
			tw(row, 0.2, { Size = UDim2.new(1, 0, 0, 58) })
			task.delay(0.2, function()
				if not open then
					inset.Visible = false
				end
			end)
		end
	end)
	bindDrag(hub, hueGrab, function(a)
		h = math.clamp(a, 0, 0.999)
		refresh()
	end, hueBar)
	bindDrag(hub, valGrab, function(a)
		v = a
		refresh()
	end, valBar)
	refresh(true)
	return obj
end

