function Tang:_layoutPetals()
	local n = #self.Pages
	for i, p in ipairs(self.Pages) do
		local ang = math.rad(-90 + (i - 1) * (360 / n))
		p.Petal.Position = UDim2.fromOffset(RING / 2 + math.cos(ang) * PETAL_R, RING / 2 + math.sin(ang) * PETAL_R)
	end
end

