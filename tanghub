local function pad(o, l, r, t, b)
	return make("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingRight = UDim.new(0, r or l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingBottom = UDim.new(0, b or t or 0),
	}, o)
end

local function isImageId(s)
	return type(s) == "number" or (type(s) == "string" and (s:match("^rbxassetid://") ~= nil or s:match("^%d+$") ~= nil))
end

local function resolveImage(src)
	if src == nil or src == "" then
		return nil
	end
	if src == "embedded" then
		return embeddedAsset("logo")
	end
	if type(src) == "number" or (type(src) == "string" and src:match("^%d+$")) then
		return "rbxassetid://" .. tostring(src)
	end
	if src:match("^rbxassetid://") then
		return src
	end
	if src:match("^https?://") then
		local ok, res = pcall(function()
			writefile("tanghub_custom_logo.png", game:HttpGet(src))
			return getcustomasset("tanghub_custom_logo.png")
		end)
		if ok then
			return res
		end
		return nil
	end
	local ok, res = pcall(function()
		if isfile(src) then
			return getcustomasset(src)
		end
	end)
	if ok then
		return res
	end
	return nil
end

local GLYPHS = {
	home = "⌂", flag = "⚑", target = "◎", user = "☻", star = "★", wrench = "✎",
	bot = "▣", gear = "⚙", list = "≡", eye = "◉", bolt = "ϟ", x = "✕", shield = "◆",
}

-- icon (embedded name, rbxassetid, or glyph text) centered inside parent
local function makeIcon(parent, icon, size, color)
	local img
	if type(icon) == "string" and B64["icon_" .. icon] then
		img = embeddedAsset("icon_" .. icon)
	elseif isImageId(icon) then
		img = resolveImage(icon)
	end
	if img then
		return make("ImageLabel", {
			BackgroundTransparency = 1,
			Image = img,
			ImageColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
		}, parent)
	end
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Text = GLYPHS[icon] or tostring(icon or "•"),
		TextSize = size,
		TextColor3 = color,
		Font = Enum.Font.GothamBold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size + 8, size + 8),
	}, parent)
end

local function setIconColor(ico, c)
	if ico:IsA("ImageLabel") then
		ico.ImageColor3 = c
	else
		ico.TextColor3 = c
	end
end

local KEYNAMES = {
	RightControl = "R Ctrl", LeftControl = "L Ctrl", RightShift = "R Shift",
	LeftShift = "L Shift", RightAlt = "R Alt", LeftAlt = "L Alt",
}
local function keyName(k)
	if not k then
		return "None"
	end
	return KEYNAMES[k.Name] or k.Name
end

local function decimalsOf(n)
	local s = string.format("%.4f", n):gsub("0+$", ""):gsub("%.$", "")
	local dot = s:find("%.")
	return dot and (#s - dot) or 0
end

-- drag helper: input is read on `area`, the value is measured along `ref`
local function bindDrag(hub, area, cb, ref)
	ref = ref or area
	local dragging = false
	local function update(input)
		local a = math.clamp((input.Position.X - ref.AbsolutePosition.X) / math.max(ref.AbsoluteSize.X, 1), 0, 1)
		cb(a)
	end
	hub:_connect(area.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(i)
		end
	end)
	hub:_connect(UserInputService.InputChanged, function(i)
		if
			dragging
			and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch)
		then
			update(i)
		end
	end)
	hub:_connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

