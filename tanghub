-- UI scale, clamped so the panel and radial always fit the screen
function Tang:_eff()
	local x, y = 1920, 1012
	pcall(function()
		local v = workspace.CurrentCamera.ViewportSize
		x, y = v.X, v.Y
	end)
	return math.clamp(math.min(self.Scale, y / 890, x / 1120), 0.45, 3)
end

function Tang:SetScale(n)
	self.Scale = n
	self:_applyScale()
end

function Tang:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Tang:_play(name)
	if not self.SoundsEnabled then
		return
	end
	local def = self._sounds[name]
	if not def then
		return
	end
	local s = make("Sound", {
		SoundId = def.Id,
		Volume = (def.Volume or 0.5) * self.SoundVolume,
		PlaybackSpeed = def.Speed or 1,
	}, self.Gui)
	s:Play()
	task.delay(2, function()
		if s then
			s:Destroy()
		end
	end)
end

function Tang:_hoverFx(button, onEnter, onLeave)
	self:_connect(button.MouseEnter, function()
		self:_play("Hover")
		if onEnter then
			onEnter()
		end
	end)
	self:_connect(button.MouseLeave, function()
		if onLeave then
			onLeave()
		end
	end)
end

function Tang.CreateHub(a, b)
	local opts = b
	if opts == nil then
		opts = a
	end
	if opts == Tang or type(opts) ~= "table" then
		opts = {}
	end

	local self = setmetatable({}, Tang)
	self._conns = {}
	self.Pages = {}
	self.State = "closed"
	self.Name = opts.Name or "TANG HUB"
	self.Subtitle = opts.Subtitle or "Control panel"
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightControl
	self.Scale = opts.Scale or 1
	self.SoundsEnabled = opts.Sounds ~= false
	self.SoundVolume = 1
	self._sounds = DEFAULT_SOUNDS
	if type(opts.Sounds) == "table" then
		self._sounds = {}
		for k, v in pairs(DEFAULT_SOUNDS) do
			self._sounds[k] = opts.Sounds[k] or v
		end
	end

	local T = {}
	for k, v in pairs(DEFAULT_THEME) do
		T[k] = v
	end
	for k, v in pairs(opts.Theme or {}) do
		T[k] = v
	end
	self.Theme = T

	local logoSrc = opts.Logo
	if logoSrc == nil or logoSrc == "" or logoSrc == "rbxassetid://0" or logoSrc == 0 then
		logoSrc = "embedded"
	end
	local logoAsset = resolveImage(logoSrc)

	local function logoOrT(parent, size, props)
		local o
		if logoAsset then
			o = make("ImageLabel", {
				BackgroundTransparency = 1,
				Image = logoAsset,
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromOffset(size, size),
			}, nil)
		else
			o = make("TextLabel", {
				BackgroundTransparency = 1,
				Text = "T",
				TextSize = size,
				TextColor3 = T.Text,
				Font = Enum.Font.GothamBlack,
				Size = UDim2.fromOffset(size, size),
			}, nil)
		end
		for k, v in pairs(props or {}) do
			o[k] = v
		end
		o.Parent = parent
		return o
	end

	-- root gui
	local gui = make("ScreenGui", {
		Name = "TangHub_" .. tostring(math.random(1000, 9999)),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
	}, nil)
	local okParent = pcall(function()
		gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
	end)
	if not okParent or not gui.Parent then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	self.Gui = gui

	------------------------------------------------------------------
	-- logo toggle button (top center)
	------------------------------------------------------------------
	local logoBtn = make("TextButton", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 18),
		Size = UDim2.fromOffset(56, 56),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, gui)
	local logoScale = make("UIScale", { Scale = 1 }, logoBtn)
	logoOrT(logoBtn, 56, {})
	local dot = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(52, 49),
		Size = UDim2.fromOffset(9, 9),
		BackgroundColor3 = T.Good,
		BorderSizePixel = 0,
	}, logoBtn)
	round(dot, 5)
	self:_hoverFx(logoBtn, function()
		tw(logoScale, 0.12, { Scale = self:_eff() * 1.1 })
	end, function()
		tw(logoScale, 0.12, { Scale = self:_eff() })
	end)

	------------------------------------------------------------------
	-- radial menu
	------------------------------------------------------------------
	local radial = make("Frame", {
		Name = "Radial",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, RADIAL_Y),
		Size = UDim2.fromOffset(RING, RING),
		BackgroundTransparency = 1,
		Visible = false,
	}, gui)
	local radialScale = make("UIScale", { Scale = 0.6 }, radial)

	local ring = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.RingFill,
		BackgroundTransparency = 0.45,
