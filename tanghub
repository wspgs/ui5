function Tang:Notify(o)
	local T = self.Theme
	o = o or {}
	local dur = o.Duration or 4
	local card = make("CanvasGroup", {
		Size = UDim2.fromOffset(320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Bg,
		BorderSizePixel = 0,
		GroupTransparency = 1,
	}, self.NotifHolder)
	round(card, 11)
	stroke(card, T.Border, 1.5, 0.35)
	pad(card, 16, 16, 12, 12)
	make("UIListLayout", { Padding = UDim.new(0, 4) }, card)
	label(card, o.Title or self.Name, 14, T.Text, Enum.Font.GothamBold, {
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
	})
	label(card, o.Content or "", 12, T.Muted, Enum.Font.Gotham, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
	})
	local barBg = make("Frame", {
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = T.Off,
		BorderSizePixel = 0,
		LayoutOrder = 3,
	}, card)
	round(barBg, 2)
	local barFill = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.AccentHi,
		BorderSizePixel = 0,
	}, barBg)
	round(barFill, 2)
	tw(card, 0.25, { GroupTransparency = 0 })
	tw(barFill, dur, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
	self:_play("Notify")
	task.delay(dur, function()
		if card.Parent then
			tw(card, 0.25, { GroupTransparency = 1 })
			task.wait(0.3)
			card:Destroy()
		end
	end)
end

