	}, gui)
	make("UIListLayout", {
		Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, self.NotifHolder)
	local notifScale = make("UIScale", { Scale = 1 }, self.NotifHolder)

	self.Radial = radial
	self._pageTitle = pageTitle
	self._pageSub = pageSub

	------------------------------------------------------------------
	-- scale + state switching
	------------------------------------------------------------------
	function self:_applyScale()
		local e = self:_eff()
		logoScale.Scale = e
		logoBtn.Position = UDim2.new(0.5, 0, 0, 18 * e)
		cardScale.Scale = e
		card.Position = UDim2.new(0.5, 0, 0.5, (RADIAL_Y + RING / 2 + 13) * e)
		radial.Position = UDim2.new(0.5, 0, 0.5, RADIAL_Y * e)
		panel.Position = UDim2.new(0.5, 0, 0, PANEL_TOP * e)
		hintScale.Scale = e
		notifScale.Scale = e * 0.9
		if self.State == "radial" then
			radialScale.Scale = e
		elseif self.State == "panel" then
			panelScale.Scale = e
		end
	end

	function self:_hideRadial()
		card.Visible = false
		tw(radialScale, 0.15, { Scale = 0.6 * self:_eff() }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.16, function()
			if self.State ~= "radial" then
				radial.Visible = false
			end
		end)
	end

	function self:_hidePanel()
		tw(panelScale, 0.15, { Scale = 0.9 * self:_eff() }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.16, function()
			if self.State ~= "panel" then
				panel.Visible = false
			end
		end)
	end

	function self:ShowRadial()
		if self.State == "panel" then
			self:_hidePanel()
		end
		self.State = "radial"
		self:_applyScale()
		self._setCenter()
		radialScale.Scale = 0.6 * self:_eff()
		radial.Visible = true
		card.Visible = true
		tw(radialScale, 0.28, { Scale = self:_eff() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		self:_play("Open")
		self:_showHint()
	end

	function self:OpenPage(page)
		if self.State == "radial" then
			self:_hideRadial()
		end
		self.State = "panel"
		self:_applyScale()
		for _, p in ipairs(self.Pages) do
			p.Scroll.Visible = (p == page)
		end
		self.CurrentPage = page
		pageTitle.Text = page.Name
		pageSub.Text = page.Subtitle
		panelScale.Scale = 0.9 * self:_eff()
		panel.Visible = true
		tw(panelScale, 0.25, { Scale = self:_eff() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		self:_play("Click")
		self:_showHint()
	end

	function self:Close()
		if self.State == "closed" then
			return
		end
		local was = self.State
		self.State = "closed"
		if was == "radial" then
			self:_hideRadial()
		elseif was == "panel" then
			self:_hidePanel()
		end
		self:_play("Close")
	end

	function self:Toggle()
		if self.State == "closed" then
			self:ShowRadial()
		else
			self:Close()
		end
	end

	function self:Destroy()
		for _, c in ipairs(self._conns) do
			c:Disconnect()
		end
		gui:Destroy()
	end

	self:_connect(logoBtn.MouseButton1Click, function()
		self:Toggle()
	end)
	self:_connect(menuBtn.MouseButton1Click, function()
		self:ShowRadial()
	end)
	self:_connect(UserInputService.InputBegan, function(i, gp)
		if not gp and i.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end)

	self:_applyScale()
	pcall(function()
		self:_connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
			self:_applyScale()
		end)
	end)

	return self
end

